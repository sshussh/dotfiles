# Local runtime state
**/__pycache__/
**/*.py[cod]
**/*.db
**/*.sqlite*
**/*.log
**/.bash_history
**/.python_history
**/.zsh_history
**/.zcompdump*

# Credentials and private machine data
**/.env
**/.env.*
**/.ssh/
**/.gnupg/
**/.aws/
**/.kube/
**/.netrc
**/.git-credentials
**/.npmrc
**/.pypirc
**/.config/dconf/user
**/.config/NetworkManager/system-connections/
**/.config/containers/auth.json
**/.local/share/containers/storage/auth.json
**/.docker/config.json
**/.config/gh/hosts.yml
**/.config/Codex/
**/.codex/
**/.config/sops/age/keys.txt
**/.config/age/
**/.local/share/age/
**/.local/share/keyrings/
**/.config/keepassxc/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.ovpn
**/*.kdbx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
