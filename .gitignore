# Never version VCS metadata, history, caches, credentials, databases, or logs.
**/.git/
**/.bash_history
**/.python_history
**/.lesshst
**/.node_repl_history
**/*.db
**/*.sqlite*
**/*.log
**/*token*
**/*secret*
**/*credential*
**/*cache*
**/__pycache__/
**/*.pyc
**/.ssh/
**/.gnupg/
**/.config/BraveSoftware/
**/.config/google-chrome/
**/.config/chromium/
**/.config/microsoft-edge*/
**/.mozilla/
**/.config/zen/
**/.config/vesktop/
**/.config/discord/
**/.config/Code/User/History/
**/.local/share/keyrings/
**/.config/dconf/user
**/.config/NetworkManager/system-connections/
**/.config/containers/auth.json
**/.local/share/containers/storage/auth.json
**/.docker/config.json
**/.config/Codex/
**/.codex/
**/.aws/
**/.kube/
**/.netrc
**/.git-credentials
**/.npmrc
**/.pypirc
**/.env
**/.env.*
**/.config/gh/hosts.yml
**/.config/zsh/.zsh_history
**/.zsh_history
**/.zcompdump*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.ovpn
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/*.kdbx
**/.config/keepassxc/
**/.config/sops/age/keys.txt
**/.config/age/
**/.local/share/age/

# Matugen runtime output (regenerated by matugen-wallpaper)
matugen/.config/matugen/backups/
matugen/.config/matugen/runtime/zsh/

