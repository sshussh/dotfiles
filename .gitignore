# Never version VCS metadata, history, caches, credentials, databases, or logs.
**/.git/
**/*history*
**/*.db
**/*.sqlite*
**/*.log
**/*token*
**/*secret*
**/*credential*
**/*cache*
**/__pycache__/
**/*.pyc

# Matugen runtime output (regenerated by matugen-wallpaper)
matugen/.config/matugen/backups/
matugen/.config/matugen/runtime/themes/Matugen/gnome-shell/
matugen/.config/matugen/runtime/icons/Matugen/scalable/
matugen/.config/matugen/runtime/zen/
matugen/.config/matugen/runtime/vim/
matugen/.config/matugen/runtime/zsh/

# Generated palettes written next to source configs
gnome-desktop/.config/gtk-3.0/matugen.css
gnome-desktop/.config/gtk-4.0/matugen.css
gnome-desktop/.config/monitors.xml
gnome-desktop/.config/monitors.xml~
terminal/.config/btop/themes/
terminal/.config/fastfetch/config.jsonc
terminal/.config/zsh/prompt.json
terminal/.config/fish/fish_variables
zed/.config/zed/themes/matugen.json
