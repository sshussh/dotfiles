{
  "text_rendering_mode": "grayscale",
  "language_models": {
  },
  "vim": {
    "gdefault": false,
  },
  "instrumentation": {
    "performance_profiler": {
      "enabled": false,
    },
  },
  "proxy": "",
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true,
  },
  "search": {
    "center_on_match": true,
    "include_ignored": true,
  },
  "code_lens": "on",
  "completion_menu_item_kind": "symbol",
  "mouse_wheel_zoom": true,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "which_key": {
    "enabled": true,
  },
  "rounded_selection": false,
  "default_open_behavior": "new_window",
  "restore_on_startup": "launchpad",
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 18.0,
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14.0,
  "use_system_path_prompts": true,
  "diff_view_style": "split",
  "agent_servers": {
    "grok-build": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "low",
        "model": "claude-fable-5",
        "mode": "auto",
      },
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "vim_mode": false,
  "edit_predictions": {
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
    },
    // "allow_data_collection": "no",
    // "provider": "ollama",
    // "mode": "eager",
    // "copilot": { "enable_next_edit_suggestions": true },

    "provider": "zed",
    "open_ai_compatible_api": {
      "model": "",
      "api_url": "",
      "prompt_format": "infer",
      "max_output_tokens": 512,
    },
  },
  "show_edit_predictions": true,
  "completions": { "words": "enabled" },
  "languages": {
    "Shell Script": {
      "show_edit_predictions": true,
    },
    "Rust": { "show_edit_predictions": false },
  },
  "disable_ai": false,
  "session": { "trust_all_worktrees": true },
  "calls": { "mute_on_join": true },
  "git": {
    "git_gutter": "tracked_files",
    "enable_diff": true,
    "branch_picker": { "show_author_name": true },
    "blame": {},
    "inline_blame": { "show_commit_summary": true, "enabled": true },
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "auto_compact": {
      "enabled": false,
    },
    "thinking_display": "always_expanded",
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": true,
      },
    ],
    "profiles": {},
    "show_turn_stats": true,
    "single_file_review": true,
    "inline_assistant_model": {
      "provider": "lmstudio",
      "model": "zed-industries_zeta-2",
      "enable_thinking": false,
    },
    "enable_feedback": true,
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
    },
    "play_sound_when_agent_done": "always",
    "default_width": 550,
    "dock": "left",
    "model_parameters": [],
  },
  "collaboration_panel": { "dock": "right", "default_width": 300 },
  "git_panel": {
    "show_count_badge": true,
    "file_icons": true,
    "collapse_untracked_diff": false,
    "status_style": "icon",
    "tree_view": true,
    "default_width": 350,
    "dock": "right",
  },
  "outline_panel": {
    "file_icons": true,
    "default_width": 350,
    "dock": "right",
  },
  "terminal": {
    "bell": "system",
    "copy_on_select": true,
    "show_count_badge": true,
    "shell": "system",
    "toolbar": {
      "breadcrumbs": true,
    },
    "default_height": 500,
    "dock": "bottom",
  },
  "project_panel": {
    "auto_open": {
      "on_drop": false,
      "on_paste": false,
      "on_create": false,
    },
    "hide_root": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "bold_folder_labels": false,
    "button": true,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "default_width": 350,
    "dock": "right",
  },
  "active_pane_modifiers": { "border_size": 0 },
  "zoomed_padding": true,
  "centered_layout": { "left_padding": null, "right_padding": null },
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true,
  },
  "tabs": { "show_diagnostics": "all", "file_icons": true, "git_status": true },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_branch_status_icon": true,
    "show_menus": false,
  },
  "diagnostics": { "inline": { "enabled": true } },
  "colorize_brackets": true,
  "middle_click_paste": false,
  "inlay_hints": { "show_background": false, "enabled": true },
  "indent_guides": { "coloring": "indent_aware" },
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "minimap": {
    "thumb": "always",
    "show": "always",
  },
  "inline_code_actions": true,
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "breakpoints": true,
    "runnables": true,
    "line_numbers": true,
  },
  "drag_and_drop_selection": { "enabled": false },
  "hover_popover_delay": 100,
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "sticky_scroll": { "enabled": false },
  "vertical_scroll_margin": 8,
  "autosave": { "after_delay": { "milliseconds": 500 } },
  "show_wrap_guides": true,
  "current_line_highlight": "none",
  "cursor_blink": false,
  "cursor_shape": "block",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Latte",
  },
  "telemetry": { "diagnostics": false, "metrics": false },
  "theme": { "mode": "dark", "light": "Matugen Light", "dark": "Matugen Dark" },
  "context_servers": {},
}
