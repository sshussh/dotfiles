#!/usr/bin/env bash
# Check (and optionally install) packages this dotfiles tree expects.
set -euo pipefail

yes=0
report_only=0
skip_dconf=0
skip_matugen=0

usage() {
  cat <<EOF
Usage: scripts/check-deps [options]

Options:
  -y, --yes          Install missing packages without asking
  --report-only      Print the status and do not install
  --skip-dconf       Do not require dconf
  --skip-matugen     Do not require DMS / Matugen / PyGObject
  -h, --help         Show this help
EOF
}

for arg in "$@"; do
  case "$arg" in
    -y|--yes) yes=1 ;;
    --report-only) report_only=1 ;;
    --skip-dconf) skip_dconf=1 ;;
    --skip-matugen) skip_matugen=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "check-deps: unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"

has_cmd() { command -v "$1" >/dev/null 2>&1; }

# A stale paru-bin can exist on PATH but fail to start after a pacman/libalpm
# soname bump (libalpm.so.15 vs .16).
paru_works() {
  has_cmd paru || return 1
  paru --version >/dev/null 2>&1
}

has_font() {
  has_cmd fc-list || return 1
  # Do not pipe fc-list into grep -q: SIGPIPE + pipefail looks like a miss.
  [[ -n "$(fc-list "$1" file 2>/dev/null)" ]]
}

has_py() {
  has_cmd python3 || return 1
  python3 -c "import $1" >/dev/null 2>&1
}

pkg_manager=""
if paru_works; then
  pkg_manager=paru
elif has_cmd pacman; then
  pkg_manager=pacman
elif has_cmd apt-get; then
  pkg_manager=apt
elif has_cmd dnf; then
  pkg_manager=dnf
fi

extension_pkg_for() {
  case "$1" in
    appindicatorsupport@rgcjonas.gmail.com) echo gnome-shell-extension-appindicator ;;
    Vitals@CoreCoding.com) echo gnome-shell-extension-vitals ;;
    dash-to-dock@micxgx.gmail.com) echo gnome-shell-extension-dash-to-dock ;;
    blur-my-shell@aunetx) echo gnome-shell-extension-blur-my-shell ;;
    clipboard-indicator@tudmotu.com) echo gnome-shell-extension-clipboard-indicator ;;
    *) echo "" ;;
  esac
}

pkg_for() {
  local id="$1"
  case "$pkg_manager" in
    paru)
      case "$id" in
        stow) echo stow ;;
        python3) echo python ;;
        python-gobject) echo python-gobject ;;
        dconf) echo dconf ;;
        dms) echo dms-shell ;;
        matugen) echo matugen ;;
        niri) echo niri ;;
        kitty) echo kitty ;;
        gnome-shell) echo gnome-shell ;;
        gnome-shell-extensions) echo gnome-shell-extensions ;;
        ghostty) echo ghostty ;;
        zed) echo zed ;;
        vscodium) echo vscodium-bin ;;
        openrgb) echo openrgb ;;
        fish) echo fish ;;
        ffmpeg) echo ffmpeg ;;
        zsh) echo zsh ;;
        fzf) echo fzf ;;
        zoxide) echo zoxide ;;
        lsd) echo lsd ;;
        bat) echo bat ;;
        fd) echo fd ;;
        fontconfig) echo fontconfig ;;
        jetbrains-mono) echo ttf-jetbrains-mono ;;
        jetbrains-mono-nerd) echo ttf-jetbrains-mono-nerd ;;
        extension-manager) echo extension-manager ;;
        zen) echo zen-browser-bin ;;
        gnome-shell-extension-appindicator) echo gnome-shell-extension-appindicator ;;
        gnome-shell-extension-vitals) echo gnome-shell-extension-vitals ;;
        gnome-shell-extension-dash-to-dock) echo gnome-shell-extension-dash-to-dock ;;
        gnome-shell-extension-blur-my-shell) echo gnome-shell-extension-blur-my-shell ;;
        gnome-shell-extension-clipboard-indicator) echo gnome-shell-extension-clipboard-indicator ;;
        git) echo git ;;
        *) echo "" ;;
      esac
      ;;
    pacman)
      case "$id" in
        stow) echo stow ;;
        python3) echo python ;;
        python-gobject) echo python-gobject ;;
        dconf) echo dconf ;;
        dms) echo dms-shell ;;
        matugen) echo matugen ;;
        niri) echo niri ;;
        kitty) echo kitty ;;
        gnome-shell) echo gnome-shell ;;
        gnome-shell-extensions) echo gnome-shell-extensions ;;
        ghostty) echo ghostty ;;
        zed) echo zed ;;
        openrgb) echo openrgb ;;
        fish) echo fish ;;
        ffmpeg) echo ffmpeg ;;
        zsh) echo zsh ;;
        fzf) echo fzf ;;
        zoxide) echo zoxide ;;
        lsd) echo lsd ;;
        bat) echo bat ;;
        fd) echo fd ;;
        fontconfig) echo fontconfig ;;
        jetbrains-mono) echo ttf-jetbrains-mono ;;
        jetbrains-mono-nerd) echo ttf-jetbrains-mono-nerd ;;
        extension-manager) echo extension-manager ;;
        gnome-shell-extension-appindicator) echo gnome-shell-extension-appindicator ;;
        gnome-shell-extension-vitals) echo gnome-shell-extension-vitals ;;
        git) echo git ;;
        *) echo "" ;;
      esac
      ;;
    apt)
      case "$id" in
        stow) echo stow ;;
        python3) echo python3 ;;
        python-gobject) echo python3-gi ;;
        dconf) echo dconf-cli ;;
        gnome-shell) echo gnome-shell ;;
        gnome-shell-extensions) echo gnome-shell-extensions ;;
        fish) echo fish ;;
        ffmpeg) echo ffmpeg ;;
        zsh) echo zsh ;;
        fzf) echo fzf ;;
        zoxide) echo zoxide ;;
        lsd) echo lsd ;;
        bat) echo bat ;;
        fd) echo fd-find ;;
        fontconfig) echo fontconfig ;;
        jetbrains-mono) echo fonts-jetbrains-mono ;;
        extension-manager) echo gnome-shell-extension-manager ;;
        git) echo git ;;
        *) echo "" ;;
      esac
      ;;
    dnf)
      case "$id" in
        stow) echo stow ;;
        python3) echo python3 ;;
        python-gobject) echo python3-gobject ;;
        dconf) echo dconf ;;
        gnome-shell) echo gnome-shell ;;
        gnome-shell-extensions) echo gnome-shell-extensions ;;
        fish) echo fish ;;
        ffmpeg) echo ffmpeg ;;
        zsh) echo zsh ;;
        fzf) echo fzf ;;
        zoxide) echo zoxide ;;
        lsd) echo lsd ;;
        bat) echo bat ;;
        fd) echo fd-find ;;
        fontconfig) echo fontconfig ;;
        jetbrains-mono) echo jetbrains-mono-fonts ;;
        git) echo git ;;
        *) echo "" ;;
      esac
      ;;
    *) echo "" ;;
  esac
}

# id|severity|kind|probe|label
# kind: cmd, cmd-any, font, py
# cmd-any probe is comma-separated commands
specs=(
  "stow|required|cmd|stow|GNU Stow"
  "python3|required|cmd|python3|Python 3"
  "dconf|required|cmd|dconf|dconf (GNOME settings)"
  "python-gobject|required|py|gi|Python GObject (Matugen watcher)"
  "dms|required|cmd|dms|DankMaterialShell CLI"
  "matugen|required|cmd|matugen|Matugen"
  "fontconfig|recommended|cmd|fc-list|fontconfig (fc-list)"
  "gnome-shell|recommended|cmd|gnome-shell|GNOME Shell"
  "gnome-shell-extensions|recommended|cmd|gnome-extensions|GNOME Extensions CLI"
  "zsh|recommended|cmd|zsh|Zsh"
  "ghostty|recommended|cmd|ghostty|Ghostty"
  "kitty|recommended|cmd|kitty|Kitty"
  "niri|recommended|cmd|niri|Niri"
  "zed|recommended|cmd-any|zeditor,zed|Zed"
  "vscodium|recommended|cmd|codium|VSCodium"
  "openrgb|recommended|cmd|openrgb|OpenRGB"
  "fish|recommended|cmd|fish|Fish"
  "ffmpeg|recommended|cmd|ffmpeg|FFmpeg (live-wallpaper frames)"
  "fzf|recommended|cmd|fzf|fzf"
  "zoxide|recommended|cmd|zoxide|zoxide"
  "lsd|recommended|cmd|lsd|lsd"
  "bat|recommended|cmd|bat|bat"
  "fd|recommended|cmd|fd|fd"
  "jetbrains-mono|recommended|font|JetBrains Mono|JetBrains Mono"
  "jetbrains-mono-nerd|recommended|font|JetBrainsMono Nerd Font|JetBrainsMono Nerd Font"
  "paru|recommended|cmd|paru|paru (AUR helper)"
  "extension-manager|recommended|cmd|extension-manager|GNOME Extension Manager"
  "zen|recommended|cmd|zen-browser|Zen Browser"
  "git|recommended|cmd|git|Git"
)

present=()
missing_required=()
missing_recommended=()
missing_ids=()

probe_ok() {
  local kind="$1" probe="$2"
  case "$kind" in
    cmd) has_cmd "$probe" ;;
    cmd-any)
      local cmd
      local IFS=,
      for cmd in $probe; do
        has_cmd "$cmd" && return 0
      done
      return 1
      ;;
    font) has_font "$probe" ;;
    py) has_py "$probe" ;;
    *) return 1 ;;
  esac
}

echo "Checking dependencies..."
echo

for spec in "${specs[@]}"; do
  IFS='|' read -r id severity kind probe label <<<"$spec"
  if [[ "$id" == dconf && "$skip_dconf" == 1 ]]; then
    continue
  fi
  if [[ "$id" == dms || "$id" == matugen || "$id" == python-gobject ]] && [[ "$skip_matugen" == 1 ]]; then
    continue
  fi
  if [[ "$id" == paru ]] && ! has_cmd pacman; then
    continue
  fi
  if [[ "$id" == paru ]]; then
    if paru_works; then
      printf '  OK    %s\n' "$label"
      present+=("$id")
    else
      printf '  MISS  %s\n' "$label"
      missing_ids+=("$id")
      missing_recommended+=("$id")
    fi
    continue
  fi
  if probe_ok "$kind" "$probe"; then
    printf '  OK    %s\n' "$label"
    present+=("$id")
  else
    printf '  MISS  %s\n' "$label"
    missing_ids+=("$id")
    if [[ "$severity" == required ]]; then
      missing_required+=("$id")
    else
      missing_recommended+=("$id")
    fi
  fi
done

missing_extensions=()
extensions_file="$repo_dir/gnome/extensions.txt"
if [[ -f "$extensions_file" ]]; then
  echo
  echo "GNOME extensions (enabled on the source machine):"
  while IFS=$'\t' read -r uuid state name source || [[ -n "${uuid:-}" ]]; do
    [[ "$uuid" == \#* || -z "$uuid" ]] && continue
    [[ "$state" != enabled ]] && continue
    if [[ -d "$HOME/.local/share/gnome-shell/extensions/$uuid" || -d "/usr/share/gnome-shell/extensions/$uuid" ]]; then
      printf '  OK    %s (%s)\n' "$name" "$uuid"
    else
      printf '  MISS  %s (%s)\n' "$name" "$uuid"
      missing_extensions+=("$uuid")
      ext_pkg="$(extension_pkg_for "$uuid")"
      if [[ -n "$ext_pkg" ]]; then
        missing_ids+=("$ext_pkg")
      fi
    fi
  done < <(awk -F'\t' 'NF>=3 && $1 !~ /^#/ {print}' "$extensions_file")
fi

if ((${#missing_ids[@]} == 0)) && ((${#missing_extensions[@]} == 0)); then
  echo
  echo "All checked dependencies are present."
  exit 0
fi

echo

needs_paru=0
to_install=()
unmapped=()

collect_packages() {
  to_install=()
  unmapped=()
  local id pkg
  for id in "${missing_ids[@]}"; do
    if [[ "$id" == paru ]]; then
      needs_paru=1
      continue
    fi
    pkg="$(pkg_for "$id")"
    if [[ -n "$pkg" ]]; then
      to_install+=("$pkg")
    else
      unmapped+=("$id")
    fi
  done
  local unique_install=() seen=" " item
  for item in "${to_install[@]}"; do
    if [[ "$seen" != *" $item "* ]]; then
      unique_install+=("$item")
      seen+=" $item "
    fi
  done
  to_install=("${unique_install[@]}")
}

set_install_cmd() {
  install_cmd=()
  ((${#to_install[@]})) || return 0
  case "$pkg_manager" in
    paru) install_cmd=(paru -S --needed "${to_install[@]}") ;;
    pacman) install_cmd=(sudo pacman -S --needed "${to_install[@]}") ;;
    apt) install_cmd=(sudo apt-get install "${to_install[@]}") ;;
    dnf) install_cmd=(sudo dnf install "${to_install[@]}") ;;
  esac
}

collect_packages
set_install_cmd

if (( needs_paru )) && has_cmd pacman && ! has_cmd paru; then
  echo "Missing paru (AUR helper). It will be built from paru-bin if you install packages."
fi

if ((${#to_install[@]})); then
  echo "Missing packages: ${to_install[*]}"
  if ((${#install_cmd[@]})); then
    echo "Install command: ${install_cmd[*]}"
  fi
fi

if ((${#unmapped[@]})); then
  echo "No package mapping for this distro; install these yourself: ${unmapped[*]}"
fi

if ((${#missing_extensions[@]})); then
  echo "Missing GNOME extensions will be downloaded from extensions.gnome.org during install."
  for uuid in "${missing_extensions[@]}"; do
    echo "  $uuid"
  done
fi

if (( report_only )); then
  if ((${#missing_required[@]})); then
    echo "Required dependencies are missing. Re-run without --simulate to install them." >&2
    exit 1
  fi
  exit 0
fi

if ((${#to_install[@]} == 0)) && (( ! needs_paru )); then
  if ((${#missing_required[@]})); then
    echo "Required dependencies are missing and cannot be auto-installed here." >&2
    exit 1
  fi
  exit 0
fi

if ((${#install_cmd[@]} == 0)) && (( ! needs_paru )); then
  if ((${#missing_required[@]})); then
    echo "Required dependencies are missing. Install them, then re-run." >&2
    exit 1
  fi
  exit 0
fi

already_deployed=0
if [[ -L "${HOME}/.zshenv" ]]; then
  already_deployed=1
fi

do_install=0
if (( yes )); then
  do_install=1
elif ((${#missing_required[@]} == 0)) && (( already_deployed )); then
  echo "Recommended tools are missing; install later with: ${install_cmd[*]}"
  do_install=0
elif [[ -t 0 ]]; then
  if ((${#missing_required[@]})); then
    read -r -p "Install missing packages now? [Y/n] " reply
    case "$reply" in
      ""|[Yy]|[Yy][Ee][Ss]) do_install=1 ;;
      *) do_install=0 ;;
    esac
  else
    read -r -p "Install recommended packages now? [y/N] " reply
    case "$reply" in
      [Yy]|[Yy][Ee][Ss]) do_install=1 ;;
      *) do_install=0 ;;
    esac
  fi
else
  echo "No TTY; not installing. Re-run with --yes or install the packages above." >&2
  do_install=0
fi

bootstrap_paru() {
  echo "Building paru from source so it links against this system's libalpm..."
  sudo pacman -S --needed git base-devel rust
  if pacman -Qq paru-bin >/dev/null 2>&1; then
    sudo pacman -Rdd --noconfirm paru-bin
  elif pacman -Qq paru >/dev/null 2>&1 && ! paru_works; then
    sudo pacman -Rdd --noconfirm paru
  fi
  local dir
  dir="$(mktemp -d "${TMPDIR:-/tmp}/paru.XXXXXX")"
  git clone --depth=1 https://aur.archlinux.org/paru.git "$dir"
  if (( yes )); then
    (cd "$dir" && makepkg -si --needed --noconfirm)
  else
    (cd "$dir" && makepkg -si --needed)
  fi
  rm -rf "$dir"
  hash -r
  pkg_manager=paru
  if ! paru_works; then
    echo "check-deps: paru still cannot run after the rebuild" >&2
    return 1
  fi
}

if (( do_install )); then
  if (( needs_paru )) && has_cmd pacman && ! paru_works; then
    bootstrap_paru
    collect_packages
    set_install_cmd
  fi
  if ((${#install_cmd[@]})); then
    "${install_cmd[@]}"
  fi
else
  echo "Skipping package install."
fi

still_required=()
for spec in "${specs[@]}"; do
  IFS='|' read -r id severity kind probe label <<<"$spec"
  [[ "$severity" != required ]] && continue
  if [[ "$id" == dconf && "$skip_dconf" == 1 ]]; then
    continue
  fi
  if [[ "$id" == matugen || "$id" == python-gobject ]] && [[ "$skip_matugen" == 1 ]]; then
    continue
  fi
  if ! probe_ok "$kind" "$probe"; then
    still_required+=("$label")
  fi
done

if ((${#still_required[@]})); then
  echo "Still missing required dependencies:" >&2
  for label in "${still_required[@]}"; do
    echo "  $label" >&2
  done
  exit 1
fi
