#!/usr/bin/env bash
# Read-only compatibility entry point retained for old bookmarks/scripts.
set -euo pipefail
repo="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)"

usage() {
  cat <<'EOF'
Usage: scripts/check-deps [--report-only]

This legacy entry point is now read-only and delegates to `dotfiles audit`.
Use `./dotfiles apply --dry-run` and then `./dotfiles apply` for installation.
EOF
}

case "${1:-}" in
  ""|--report-only)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    echo "check-deps: deprecated; running the pinned workstation audit" >&2
    exec "$repo/dotfiles" audit --profile "${DOTFILES_PROFILE:-workstation}"
    ;;
  -h|--help)
    usage
    ;;
  *)
    echo "check-deps: installation options were retired because they bypassed source pins" >&2
    usage >&2
    exit 2
    ;;
esac
