export ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# The controller installs Zinit, Oh My Zsh, and plugins at full Git commits.
# Never clone HEAD during shell startup: run `~/.dotfiles/dotfiles apply` when
# one of these pinned sources is missing.
if [[ -r "${ZINIT_HOME}/zinit.zsh" ]]; then
  source "${ZINIT_HOME}/zinit.zsh"
  zinit_root="${ZINIT_HOME:h}"
  omz_root="${zinit_root}/ohmyzsh.git"

  # zsh-completions must extend fpath before compinit; Oh My Zsh's Git plugin
  # then expects compdef to exist while it is sourced.
  completions_plugin="${zinit_root}/plugins/zsh-users---zsh-completions"
  if [[ -d "$completions_plugin" ]]; then
    zinit light zsh-users/zsh-completions
  else
    print -u2 'zsh: pinned plugin missing: zsh-users/zsh-completions'
  fi
  autoload -Uz compinit
  compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"

  for omz_file in \
    lib/git.zsh \
    plugins/git/git.plugin.zsh \
    plugins/sudo/sudo.plugin.zsh \
    plugins/archlinux/archlinux.plugin.zsh \
    plugins/command-not-found/command-not-found.plugin.zsh
  do
    if [[ -r "${omz_root}/${omz_file}" ]]; then
      source "${omz_root}/${omz_file}"
    else
      print -u2 "zsh: pinned Oh My Zsh source missing: ${omz_file}"
    fi
  done

  # Each plugin directory is pre-populated at its profile revision. The guard
  # prevents Zinit from silently fetching an unpinned HEAD.
  for plugin in \
    zsh-users/zsh-autosuggestions \
    Aloxaf/fzf-tab
  do
    plugin_dir="${zinit_root}/plugins/${plugin//\//---}"
    if [[ -d "$plugin_dir" ]]; then
      zinit light "$plugin"
    else
      print -u2 "zsh: pinned plugin missing: ${plugin}"
    fi
  done
  zinit cdreplay -q
else
  print -u2 'zsh: pinned Zinit runtime is missing; run ~/.dotfiles/dotfiles apply'
  autoload -Uz compinit
  compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"
fi

# completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':fzf-tab:*' fzf-flags --height=60% --border=rounded
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'lsd --color=always --icon=always $realpath 2>/dev/null || ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'lsd --color=always --icon=always $realpath 2>/dev/null || ls --color $realpath'
zstyle ':fzf-tab:complete:ls:*' fzf-preview 'lsd --color=always --icon=always $realpath 2>/dev/null || ls --color $realpath'
zstyle ':fzf-tab:complete:systemctl-*:*' fzf-preview 'SYSTEMD_COLORS=1 systemctl status $word'
zstyle ':fzf-tab:complete:git-(add|diff|restore):*' fzf-preview \
  'git diff --color=always $realpath 2>/dev/null | head -200'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview \
  'case "$group" in
    "modified file") git diff --color=always $word ;;
    "recent commit object name") git show --color=always $word | head -200 ;;
    *) git log --oneline --graph --color=always $word | head -50 ;;
  esac'

# history
HISTSIZE=50000
SAVEHIST=50000
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTDUP=erase
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_VERIFY

# quality-of-life options
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END
setopt PATH_DIRS
setopt GLOB_DOTS
setopt EXTENDED_GLOB
setopt LONG_LIST_JOBS
setopt NOTIFY

# keybindings
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[3;5~' kill-word
bindkey '^H' backward-kill-word
bindkey '^[[Z' reverse-menu-complete
bindkey '^[[3~' delete-char
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line

# shell integrations
eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"

# Autosuggestion appearance
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

# direnv (optional)
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# Syntax highlighting must load after every plugin and ZLE widget definition.
if (( ${+functions[zinit]} )); then
  syntax_plugin="${ZINIT_HOME:h}/plugins/zsh-users---zsh-syntax-highlighting"
  if [[ -d "$syntax_plugin" ]]; then
    zinit light zsh-users/zsh-syntax-highlighting
  else
    print -u2 'zsh: pinned plugin missing: zsh-users/zsh-syntax-highlighting'
  fi
fi

fastfetch
