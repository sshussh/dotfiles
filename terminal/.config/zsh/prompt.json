{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}{{ if .Root }} #{{ end }} · {{ .Shell }}",
  "palette": {
    "bg": "#101010",
    "fg": "#ffffff",
    "muted": "#7e7e7e",
    "surface": "#1c1c1c",
    "blue": "#aca1cf",
    "lavender": "#b9aeda",
    "sapphire": "#b9aeda",
    "sky": "#aca1cf",
    "teal": "#99ffe4",
    "green": "#90b99f",
    "yellow": "#e6b99d",
    "peach": "#ffc799",
    "maroon": "#f5a191",
    "red": "#ff8080",
    "mauve": "#e29eca",
    "pink": "#ecaad6",
    "flamingo": "#f591b2",
    "rosewater": "#ffc799",
    "overlay": "#a0a0a0",
    "mint": "#99ffe4",
    "orange": "#ffc799"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:lavender",
          "template": "{{ if .WSL }}WSL {{ end }}{{ .Icon }} ",
          "options": {
            "macos": "\uf179",
            "linux": "\uf17c",
            "windows": "\ue62a"
          }
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:peach",
          "template": "{{ if .SSHSession }}\uf023 {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": "/"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:sapphire{{ end }}",
            "{{ if gt .Behind 0 }}p:mauve{{ end }}"
          ],
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046{{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692{{ .StashCount }}{{ end }} ",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "\ue73c {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": "\ue718 {{ .Full }} ",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:sky",
          "template": "\ue627 {{ .Full }} ",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:peach",
          "template": "\ue7a8 {{ .Full }} ",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:peach",
          "template": "\uf252 {{ .FormattedMs }} ",
          "options": {
            "threshold": 300,
            "style": "austin"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "\u2718 {{ reason .Code }} ",
          "options": {
            "always_enabled": false
          }
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "\uf0e7 "
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow": "hidden",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:muted",
          "template": "{{ .CurrentDate | date \"15:04:05\" }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:orange",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "\u276f"
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "template": "\u276f "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "template": "\u2026 "
  }
}
