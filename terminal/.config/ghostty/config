# Font Configuration
font-size = 14

# Window Configuration
window-decoration = true
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.9
background-blur-radius = 20
background-blur = true

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal behavior
mouse-hide-while-typing = true
# Copy every selection to both the primary selection and system clipboard.
copy-on-select = clipboard
confirm-close-surface = false

# Show the in-app toast after copying a selection.
app-notifications = clipboard-copy

# Key bindings
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = ctrl+shift+]=goto_split:right
keybind = ctrl+shift+[=goto_split:left
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+==equalize_splits

# Material 3 UI elements
unfocused-split-opacity = 0.8
# unfocused-split-fill = #44464f


# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Application behavior
gtk-single-instance = true

# Generated color theme
theme = matugen
