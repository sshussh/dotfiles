#!/usr/bin/env bash
# Interactively switch Ghostty theme (rewrites `theme =` in the main config).
# Usage: ghostty-theme [theme-name]
#   no args  → fzf picker
#   args     → set theme by exact name (as in `ghostty +list-themes`)

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config"

if [[ ! -f "$CONFIG" ]]; then
  echo "ghostty-theme: config not found at $CONFIG" >&2
  exit 1
fi

list_themes() {
  ghostty +list-themes 2>/dev/null | sed 's/ (resources)$//; s/ (.*)$//'
}

pick_theme() {
  if [[ $# -ge 1 ]]; then
    printf '%s\n' "$*"
    return
  fi
  if ! command -v fzf >/dev/null 2>&1; then
    echo "ghostty-theme: fzf not found; pass a theme name explicitly" >&2
    echo "Available:" >&2
    list_themes | head -40 >&2
    exit 1
  fi
  list_themes | fzf --prompt='Ghostty theme > ' --height=40% --reverse
}

theme="$(pick_theme "$@" || true)"
if [[ -z "${theme:-}" ]]; then
  echo "ghostty-theme: cancelled" >&2
  exit 1
fi

# Validate theme exists in list (allow absolute paths as custom themes)
if [[ "$theme" != /* ]]; then
  if ! list_themes | grep -Fxq "$theme"; then
    echo "ghostty-theme: unknown theme: $theme" >&2
    exit 1
  fi
fi

# Replace existing theme = line, or append
if grep -qE '^theme\s*=' "$CONFIG"; then
  # Use a temp file for portable in-place edit
  tmp="$(mktemp)"
  # Escape & for sed replacement
  esc_theme="${theme//\\/\\\\}"
  esc_theme="${esc_theme//&/\\&}"
  sed -E "s|^theme[[:space:]]*=.*$|theme = ${esc_theme}|" "$CONFIG" >"$tmp"
  mv "$tmp" "$CONFIG"
else
  printf '\ntheme = %s\n' "$theme" >>"$CONFIG"
fi

if ghostty +validate-config >/dev/null 2>&1; then
  echo "theme = $theme"
  echo "Reload Ghostty with ctrl+shift+, (or open a new window)."
else
  echo "ghostty-theme: config failed validation — check $CONFIG" >&2
  ghostty +validate-config 2>&1 || true
  exit 1
fi
