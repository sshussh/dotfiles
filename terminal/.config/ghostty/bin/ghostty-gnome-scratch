#!/usr/bin/env bash
# GNOME stand-in for Ghostty "quick terminal" (Mutter has no wlr-layer-shell).
#
# Modes:
#   ghostty-gnome-scratch            Launch a scratch Ghostty window
#   ghostty-gnome-scratch install    Register Super+grave as a GNOME custom shortcut
#   ghostty-gnome-scratch uninstall  Remove that custom shortcut

set -euo pipefail

NAME="ghostty-scratch"
BINDING="<Super>grave"
COMMAND="ghostty --class=com.mitchellh.ghostty.scratch --title=Scratch --window-width=120 --window-height=28"
PATH_KB="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/${NAME}/"
SCHEMA_LIST="org.gnome.settings-daemon.plugins.media-keys"
SCHEMA_ITEM="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${PATH_KB}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [run|install|uninstall]

  run (default)  Open a scratch Ghostty window
  install        Register GNOME shortcut Super+\` → scratch window
  uninstall      Remove that custom shortcut

Mutter cannot host Ghostty's built-in quick terminal. This is the workaround:
an OS-level shortcut that opens a normal Ghostty window. Inside Ghostty, use
ctrl+shift+alt+f to float on top.
EOF
}

run_scratch() {
  exec ghostty \
    --class=com.mitchellh.ghostty.scratch \
    --title=Scratch \
    --window-width=120 \
    --window-height=28
}

list_contains_path() {
  local list="$1"
  [[ "$list" == *"'${PATH_KB}'"* ]] || [[ "$list" == *"\"${PATH_KB}\""* ]]
}

install_shortcut() {
  command -v gsettings >/dev/null || { echo "gsettings not found" >&2; exit 1; }
  command -v python3 >/dev/null || { echo "python3 not found" >&2; exit 1; }

  gsettings set "$SCHEMA_ITEM" name 'Ghostty Scratch'
  gsettings set "$SCHEMA_ITEM" command "$COMMAND"
  gsettings set "$SCHEMA_ITEM" binding "$BINDING"

  local list new_list
  list="$(gsettings get "$SCHEMA_LIST" custom-keybindings)"
  new_list="$(PATH_KB="$PATH_KB" LIST="$list" python3 - <<'PY'
import ast, os
paths = ast.literal_eval(os.environ["LIST"])
p = os.environ["PATH_KB"]
if p not in paths:
    paths.append(p)
print("[" + ", ".join(repr(x) for x in paths) + "]")
PY
)"
  # gsettings wants single-quoted GVariant strings
  new_list="${new_list//\"/\'}"
  gsettings set "$SCHEMA_LIST" custom-keybindings "$new_list"

  echo "Installed GNOME shortcut:"
  echo "  $BINDING → $COMMAND"
  echo "If Super+grave is taken, change it in Settings → Keyboard → Custom Shortcuts."
  echo "In the scratch window: ctrl+shift+alt+f floats on top."
}

uninstall_shortcut() {
  command -v gsettings >/dev/null || { echo "gsettings not found" >&2; exit 1; }
  command -v python3 >/dev/null || { echo "python3 not found" >&2; exit 1; }

  local list new_list
  list="$(gsettings get "$SCHEMA_LIST" custom-keybindings)"
  new_list="$(PATH_KB="$PATH_KB" LIST="$list" python3 - <<'PY'
import ast, os
paths = ast.literal_eval(os.environ["LIST"])
p = os.environ["PATH_KB"]
paths = [x for x in paths if x != p]
print("[" + ", ".join(repr(x) for x in paths) + "]")
PY
)"
  new_list="${new_list//\"/\'}"
  gsettings set "$SCHEMA_LIST" custom-keybindings "$new_list"

  gsettings reset "$SCHEMA_ITEM" name 2>/dev/null || true
  gsettings reset "$SCHEMA_ITEM" command 2>/dev/null || true
  gsettings reset "$SCHEMA_ITEM" binding 2>/dev/null || true
  echo "Removed shortcut $PATH_KB"
}

case "${1:-run}" in
  -h|--help|help) usage ;;
  install) install_shortcut ;;
  uninstall) uninstall_shortcut ;;
  run) run_scratch ;;
  *) usage; exit 1 ;;
esac
