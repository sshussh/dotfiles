#!/usr/bin/env bash
set -euo pipefail
repo="$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)"
command -v pre-commit >/dev/null 2>&1 || {
  echo "pre-commit is not installed" >&2
  exit 1
}
pre-commit validate-config "$repo/.pre-commit-config.yaml" >/dev/null
hook="$repo/.git/hooks/pre-commit"
[[ -x "$hook" ]] && grep -q 'pre-commit' "$hook" || {
  echo "pre-commit hook is not installed for this clone" >&2
  exit 1
}
echo "pre-commit configuration and hook are active"
