#!/usr/bin/env bash
set -euo pipefail
repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
source_file="$repo/state/mimeapps/mimeapps.list"
destination="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"

[[ -f "$source_file" ]] || { echo "mimeapps snapshot is missing" >&2; exit 1; }
[[ -f "$destination" && ! -L "$destination" ]] || {
  echo "mimeapps runtime state is missing or still symlinked" >&2
  exit 1
}
cmp -s -- "$source_file" "$destination" || {
  echo "mimeapps runtime state differs; run './dotfiles capture --profile workstation' to review it" >&2
  exit 1
}
echo "mimeapps runtime state matches the snapshot"
