#!/usr/bin/env bash
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/../.." && pwd)
. "$repo/state/lib/mutable-files.sh"
mutable_audit "$here/pavucontrol.ini" "${XDG_CONFIG_HOME:-$HOME/.config}/pavucontrol.ini"
echo "pavucontrol runtime state matches the snapshot"
