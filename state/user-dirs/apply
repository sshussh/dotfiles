#!/usr/bin/env bash
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/../.." && pwd)
. "$repo/state/lib/mutable-files.sh"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

for name in user-dirs.dirs user-dirs.locale; do
  mutable_install "$here/$name" "$config_home/$name" \
    "$repo/gnome-desktop/.config/$name"
done

while IFS= read -r line; do
  if [[ "$line" =~ ^XDG_[A-Z0-9_]+_DIR=\"\$HOME/([^\"]+)\"$ ]]; then
    relative=${BASH_REMATCH[1]}
    case "/$relative/" in
      *"/../"*|*"/./"*) echo "unsafe user directory: $relative" >&2; exit 1 ;;
    esac
    mkdir -p -- "$HOME/$relative"
  fi
done <"$here/user-dirs.dirs"
echo "installed user directories as mutable runtime state"
