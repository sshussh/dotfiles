#!/usr/bin/env bash
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/../.." && pwd)
. "$repo/state/lib/mutable-files.sh"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
for name in user-dirs.dirs user-dirs.locale; do
  mutable_capture "$config_home/$name" "$here/$name"
done
echo "captured user-directory runtime state"
