#!/usr/bin/env bash
set -euo pipefail
command -v codium >/dev/null 2>&1 || { echo "VSCodium is not installed" >&2; exit 1; }
destination="$(dirname "$0")/extensions.txt"
temporary=$(mktemp "${destination}.tmp.XXXXXX")
trap 'rm -f "$temporary"' EXIT
codium --list-extensions --show-versions | LC_ALL=C sort >"$temporary"
[[ -s "$temporary" ]] || { echo "refusing to replace the manifest with an empty capture" >&2; exit 1; }
mv -- "$temporary" "$destination"
trap - EXIT
