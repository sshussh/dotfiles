#!/usr/bin/env bash
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo=$(CDPATH= cd -- "$here/../.." && pwd)
. "$repo/state/lib/mutable-files.sh"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}/OpenRGB"
for snapshot in "$here"/files/*; do
  mutable_audit "$snapshot" "$config_home/${snapshot##*/}"
done
echo "OpenRGB runtime data matches the reviewed snapshots"
