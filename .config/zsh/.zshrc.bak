# Environment

# zsh
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"   # dotfiles dir
export HISTFILE="$ZDOTDIR/.zhistory"    # history filepath
export HISTSIZE=10000                   # max events for internal history
export SAVEHIST=10000                   # max events in history file

# spicetify
export PATH=$PATH:/home/shush/.spicetify

# editors
export EDITOR="nvim"
export VISUAL="code"

# oh my posh
eval "$(oh-my-posh init zsh --config '/home/shush/.config/oh-my-posh/mytheme.omp.json')"

# Rust
export PATH=$PATH:/usr/sbin
export PATH=$PATH:/home/shush/.cargo/bin

# JetBrains
export PATH=$PATH:/home/shush/.local/share/JetBrains/Toolbox/scripts

# Golang
GOPATH=$HOME/go
export PATH=$PATH:/usr/local/go/bin:$GOPATH/bin

# Added by Toolbox App
export PATH="$PATH:/home/shush/.local/share/JetBrains/Toolbox/scripts"

# --------- #

# lsd - better ls
alias ls="lsd --color=always"
alias ll="lsd -la --color=always"
alias la="lsd -a --color=always"

alias grep="grep --color=auto"
alias cls="clear"

alias ff="fastfetch"

. "$HOME/.local/bin/env"
