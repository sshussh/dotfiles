// documentation: https://zed.dev/docs/configuring-zed
{
  "debugger": {
    "button": true
  },
  "search": {
    "button": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "prettier": {
    "allowed": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "disable_ai": false,
  "use_system_path_prompts": true,
  "audio": {
    "experimental.rodio_audio": true
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": false
    }
  },
  "notification_panel": {
    "button": true
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 1.0
  },
  "use_system_window_tabs": false,
  "centered_layout": {
    "left_padding": 0.2
  },
  "bottom_dock_layout": "full",
  "preview_tabs": {
    "enabled": true,
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true,
    "show": true
  },
  "title_bar": {
    "show_user_picture": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_menus": false,
    "show_branch_icon": true
  },
  "completion_menu_scrollbar": "auto",
  "middle_click_paste": false,
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },
  "toolbar": {
    "code_actions": true
  },
  "scrollbar": {
    "show": "auto"
  },
  "gutter": {
    "line_numbers": true
  },
  "drag_and_drop_selection": {
    "delay": 200
  },
  "hover_popover_delay": 200,
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "sticky_scroll": {
    "enabled": true
  },
  "context_servers": {},
  "vim_mode": false,
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Zed (Default)"
  },
  "outline_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    },
    "enabled_in_text_threads": true
  },
  "languages": {
    "C++": {
      "tab_size": 4,
      "inlay_hints": {
        "show_background": true,
        "enabled": true
      },
      "indent_guides": {
        "active_line_width": 3,
        "line_width": 1,
        "background_coloring": "disabled"
      },
      "formatter": "auto"
    },
    "Rust": {
      "show_edit_predictions": false
    }
  },
  "show_edit_predictions": true,
  "git_panel": {
    "dock": "right"
  },
  "project_panel": {
    "button": true,
    "hide_hidden": false,
    "hide_root": false,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "dock": "right"
  },
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "agent": {
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "open": true,
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": true,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "terminal": true,
          "thinking": true,
          "web_search": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "always_allow_tool_actions": true,
    "default_profile": "ask",
    "play_sound_when_agent_done": true,
    "dock": "left",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.5"
    }
  },
  "buffer_font_family": ".ZedMono",
  "ui_font_family": ".ZedMono",
  "ui_font_size": 16.0,
  "buffer_font_size": 16,
  "ui_font_features": {
    "calt": true
  },
  "buffer_font_features": {
    "calt": true
  },
  "terminal": {
    "scrollbar": {
      "show": "auto"
    },
    "copy_on_select": false,
    "shell": "system",
    "button": true,
    "toolbar": {
      "breadcrumbs": true
    },
    "dock": "bottom",
    "font_family": ".ZedMono"
  },
  "theme": {
    "mode": "system",
    "light": "The Dark Side",
    "dark": "Ayu Dark"
  },
  "autosave": {
    "after_delay": { "milliseconds": 0 }
  },
  "minimap": {
    "show": "never",
    "display_in": "all_editors",
    "thumb": "always",
    // How the minimap thumb border should look.
    // This setting can take five values:
    // 1. Display a border on all sides of the thumb:
    //    "thumb_border": "full"
    // 2. Display a border on all sides except the left side of the thumb:
    //    "thumb_border": "left_open" (default)
    // 3. Display a border on all sides except the right side of the thumb:
    //    "thumb_border": "right_open"
    // 4. Display a border only on the left side of the thumb:
    //    "thumb_border": "left_only"
    // 5. Display the thumb without any border:
    //    "thumb_border": "none"
    "current_line_highlight": null,
    "max_width_columns": 80
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true
    }
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": false
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "always"
          }
        },
        "rust": {
          "analyzerTargetDir": true
        }
      }
    }
  }
}
