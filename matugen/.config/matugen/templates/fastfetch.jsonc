{
  "logo": {
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.primary_container.default.hex}}",
      "3": "{{colors.secondary.default.hex}}",
      "4": "{{colors.tertiary.default.hex}}",
      "5": "{{colors.primary_fixed.default.hex}}",
      "6": "{{colors.secondary_fixed.default.hex}}",
      "7": "{{colors.tertiary_fixed.default.hex}}",
      "8": "{{colors.primary_fixed_dim.default.hex}}",
      "9": "{{colors.on_surface_variant.default.hex}}"
    }
  },
  "display": {
    "separator": "  ·  ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.secondary.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}",
      "separator": "{{colors.outline.default.hex}}"
    },
    "bar": {
      "color": {
        "elapsed": "{{colors.primary.default.hex}}",
        "total": "{{colors.surface_container_highest.default.hex}}",
        "border": "{{colors.outline.default.hex}}"
      }
    },
    "percent": {
      "color": {
        "green": "{{colors.green.default.hex}}",
        "yellow": "{{colors.yellow.default.hex}}",
        "red": "{{colors.error.default.hex}}"
      }
    },
    "temp": {
      "color": {
        "green": "{{colors.green.default.hex}}",
        "yellow": "{{colors.yellow.default.hex}}",
        "red": "{{colors.error.default.hex}}"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    {
      "type": "kernel",
      "format": "{release}"
    },
    "uptime",
    {
      "type": "packages",
      "combined": true
    },
    "shell",
    {
      "type": "display",
      "compactType": "original",
      "key": "Resolution"
    },
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    {
      "type": "terminalfont",
      "format": "{/name}{-}{/}{name}{?size} {size}{?}"
    },
    "cpu",
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}"
    },
    "break",
    "colors"
  ]
}
