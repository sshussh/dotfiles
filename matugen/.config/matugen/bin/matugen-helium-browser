#!/usr/bin/env python3
"""Apply the latest Matugen browser color before launching Helium."""

from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import sys


USER_HOME = Path.home()
SYNC = USER_HOME / ".local" / "bin" / "matugen-wallpaper"
HELIUM = shutil.which("helium-browser") or "/usr/bin/helium-browser"


def main() -> int:
    # This is deliberately best-effort: launching the browser must still work
    # if a profile is currently open or a palette has not been generated yet.
    subprocess.run([str(SYNC), "--sync-helium"], check=False)
    os.execv(HELIUM, [HELIUM, *sys.argv[1:]])
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
